        <mxCell id="57" value="&lt;b&gt;Async Streaming (Read-Only)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontColor=#0F172A;fontSize=11;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" parent="1" edge="1" source="27" target="51">
