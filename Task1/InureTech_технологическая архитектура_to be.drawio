        <mxCell id="51" value="&lt;div style='font-size:13px; font-weight:bold; color:#1D4ED8;'&gt;🐘 PostgreSQL Asynchronous Standby&lt;/div&gt;&lt;div style='font-size:11px; color:#334155; margin-top:2px;'&gt;&lt;b&gt;Read-Only реплика&lt;/b&gt; (аналитика settlement) | Кворум 3 узлов | PgBouncer&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
